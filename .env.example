# Copiar a .env.local y rellenar con los valores del proyecto.
# Dashboard de Supabase → Project Settings → API

# URL del proyecto. Pública.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Llave service_role. Hace bypass de RLS: es equivalente a la contraseña de la
# base de datos. Solo se usa desde route handlers (server-side) y nunca lleva el
# prefijo NEXT_PUBLIC_, que la expondría en el bundle del navegador.
SUPABASE_SERVICE_ROLE_KEY=
